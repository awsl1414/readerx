        {
          "title": "古代言情",
          "url": "/mm/all?chanId=80&siteid=0&page={{page}}"
        },
        {
          "title": "现代言情",
          "url": "/mm/all?chanId=82&siteid=0&page={{page}}"
        }
      ],
      "rules": {
        "list": { "css": "#book-img-text li" },
        "name": { "css": "h2 a", "attr": "text" },
        "url": {
          "css": "a[data-bid]",
          "attr": "data-bid",
          "transform": [{ "template": "https://m.qidian.com/book/{{result}}/" }]
        },
        "author": { "css": ".author .name", "attr": "text" },
        "cover": { "css": ".book-img-box img", "attr": "src" },
        "intro": { "css": ".intro", "attr": "text" },
        "lastChapter": {
          "css": ".update a",
          "attr": "text",
          "transform": [{ "replace": { "pattern": "最新更新 ", "with": "" } }]
        }
