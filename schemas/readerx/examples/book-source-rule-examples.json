        },
        {
          "title": "都市娱乐",
          "url": "/category/getbooklist?columntype=99&pageid={{page}}&pagesize=20&book_size=-1&category_id1=1001&order_type=2&status=-1"
        },
        {
          "title": "奇幻玄幻",
          "url": "/category/getbooklist?columntype=99&pageid={{page}}&pagesize=20&book_size=-1&category_id1=1002&order_type=2&status=-1"
        },
        {
          "title": "女生频道",
          "url": "/category/getbooklist?columntype=98&pageid={{page}}&pagesize=20&book_size=-1&category_id1=-1&order_type=2&status=-1"
        },
        {
          "title": "出版频道",
          "url": "/category/getbooklist?columntype=6000&pageid={{page}}&pagesize=20&typeid=-1&order_type=2&status=-1"
        }
      ],
      "responseType": "json",
      "rules": {
        "list": { "jsonpath": "$.result.books[*]" },
        "name": { "jsonpath": "$.bookname" },
        "url": {
          "template": "https://anduril.xmkanshu.com/v3/book/get_book_info?p1=H5&book_id={{$.bookid}}&site_id=0"
        },
        "author": { "jsonpath": "$.authorname" },
        "cover": { "jsonpath": "$.frontcover" },
        "intro": { "jsonpath": "$.bookdesc" },
        "kind": { "jsonpath": "$.booktypename" },
        "wordCount": { "template": "{{$.booksize}}万字" }
      }
    },
    "bookInfo": {
      "responseType": "json",
      "rules": {
        "name": { "jsonpath": "$.result.book_name" },
        "author": { "jsonpath": "$.result.author_name" },
        "cover": { "jsonpath": "$.result.cover_picture" },
        "intro": { "jsonpath": "$.result.book_desc" },
        "lastChapter": {
          "jsonpath": "$.result.last_chapter_name",
          "transform": [
            {
              "replace": {
                "pattern": "正文卷\\.|正文\\.|VIP卷\\.|默认卷\\.|卷_|VIP章节\\.|免费章节\\.|章节目录\\.",
                "with": ""
              }
            }
          ]
        },
        "tocUrl": {
          "template": "https://anduril.xmkanshu.com/v3/book/get_last_chapter_list?bookid={{$.result.book_id}}&page=1&pagesize=100000"
        },
        "wordCount": { "jsonpath": "$.result.book_size" }
      }
    },
    "toc": {
      "responseType": "json",
      "rules": {
        "list": { "jsonpath": "$.result.pageList" },
        "name": {
          "jsonpath": "$.chapter_name",
          "transform": [
            {
              "replace": {
                "pattern": "正文卷\\.|正文\\.|VIP卷\\.|默认卷\\.",
                "with": ""
              }
            }
          ]
        },
        "url": {
          "template": "https://www.xmkanshu.com/service/getContent?bkid={{bookId}}&crid={{$.chapter_id}}&pg=1"
        },
        "updateTime": { "jsonpath": "$.createdate" }
      }
    },
    "content": {
      "responseType": "json",
      "nextUrl": {
        "js": "const a = baseUrl.match(/pg=(\\d+)/)[1]; a && Number(a) < {{$.result.pagecount}} ? baseUrl.replace(/pg=.+/, 'pg=' + (Number(a) + 1)) : ''"
      },
      "rules": {
        "text": { "template": "{{$.result.content}}" }
      }
    }
  },
