    "bookInfo": {
      "rules": {
        "name": { "xpath": "//meta[@property='og:novel:book_name']/@content" },
        "author": { "xpath": "//meta[@property='og:novel:author']/@content" },
        "cover": { "xpath": "//meta[@property='og:image']/@content" },
        "intro": { "xpath": "//meta[@property='og:description']/@content" },
        "kind": {
          "xpath": "//meta[@property='og:novel:category' or @property='og:novel:status' or @property='og:novel:update_time']/@content"
        },
        "lastChapter": {
          "xpath": "//meta[@property='og:novel:latest_chapter_name']/@content"
        },
        "tocUrl": { "css": "#details-menu a", "attr": "href" },
        "wordCount": {
          "css": ".book-meta",
          "attr": "text",
          "transform": [{ "replace": { "pattern": "\\|.*$", "with": "" } }]
        }
      }
    },
    "toc": {
      "responseType": "html",
      "rules": {
        "list": {
          "regex": ":\"sS\":(\\d),.*?\"cN\":\"(.*?)\",\"id\":(\\d+),.*?\"uT\":\"(.*?)\""
        },
        "name": { "regex": "\"cN\":\"(.*?)\"" },
        "url": {
          "regex": "\"id\":(\\d+)",
          "transform": [
            {
              "template": "https://vipreader.qidian.com/chapter/{{bookId}}/{{result}}/"
            }
          ]
        },
        "isVip": { "regex": ":\"sS\":(\\d)" },
        "updateTime": {
          "regex": "\"uT\":\"(.*?)\"",
          "transform": [{ "replace": { "pattern": "\".*", "with": "" } }]
        }
      }
    },
    "content": {
      "rules": {
        "text": { "css": ".read-content", "attr": "html" }
      }
    }
  },
  {
    "$schema": "readerx/book-source-rule/v1",
    "id": "http://appi.kuwo.cn",
    "name": "酷我小说",
    "type": "novel",
    "tags": ["API"],
    "baseUrl": "http://appi.kuwo.cn",
    "headers": {
      "Accept": "*/*",
      "Connection": "Close",
      "User-Agent": "Dalvik/2.1.0 (Linux; U; Android 8.0.0)"
    },
    "enabled": true,
    "weight": 50,
    "order": 4,
    "updatedAt": "2024-04-23T10:32:03+08:00",
    "search": {
      "url": "/novels/api/book/search?keyword={{key}}&pi={{page}}&ps=30",
      "responseType": "json",
      "rules": {
        "list": { "jsonpath": "$.data" },
        "name": { "jsonpath": "$.title" },
        "url": { "template": "/novels/api/book/{{$.book_id}}" },
        "author": { "jsonpath": "$.author_name" },
        "cover": { "jsonpath": "$.cover_url" },
        "intro": { "jsonpath": "$.intro" },
        "kind": {
          "template": "{{$.category_name}},{{$.status}}",
          "transform": [
            { "replace": { "pattern": "30", "with": "连载" } },
            { "replace": { "pattern": "50", "with": "完结" } }
          ]
        },
        "wordCount": { "jsonpath": "$.all_words" }
      }
    },
    "bookInfo": {
      "responseType": "json",
      "init": { "jsonpath": "$.data" },
      "rules": {
        "name": { "jsonpath": "$.title" },
        "author": { "jsonpath": "$.author_name" },
        "cover": { "jsonpath": "$.cover_url" },
        "intro": { "jsonpath": "$.intro" },
        "kind": {
          "template": "{{$.category_name}},{{$.status}}",
          "transform": [
            { "replace": { "pattern": "30", "with": "连载" } },
            { "replace": { "pattern": "50", "with": "完结" } },
            { "replace": { "pattern": "\\s..:.*", "with": "" } }
          ]
        },
        "lastChapter": {
          "jsonpath": "$.new_chapter_name",
          "transform": [
            {
              "replace": {
                "pattern": "正文卷\\.|正文\\.|VIP卷\\.|默认卷\\.|卷_|VIP章节\\.|免费章节\\.|章节目录\\.",
                "with": ""
              }
            }
          ]
        },
        "tocUrl": {
          "template": "/novels/api/book/{{$.book_id}}/chapters?paging=0"
        },
        "wordCount": { "jsonpath": "$.all_words" }
      }
    },
    "toc": {
      "responseType": "json",
      "rules": {
        "list": { "jsonpath": "$.data" },
        "name": {
          "jsonpath": "$.chapter_title",
          "transform": [
            {
              "replace": {
                "pattern": "正文卷\\.|正文\\.|VIP卷\\.|默认卷\\.|卷_|VIP章节\\.|免费章节\\.|章节目录\\.",
                "with": ""
              }
            }
          ]
        },
        "url": {
          "template": "/novels/api/book/{{$.book_id}}/chapters/{{$.chapter_id}}"
        },
        "updateTime": { "template": "{{$.volume_name}}•{{$.original_words}}字" }
      }
    },
    "content": {
      "responseType": "json",
      "rules": {
        "text": { "jsonpath": "$.data.content" }
      }
    }
  },
